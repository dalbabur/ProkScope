{
  "name": "ProkScope",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "version": "latest" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y minimap2 samtools bcftools tabix  && pip install -r backend/requirements.txt && npm ci --prefix frontend --ignore-scripts",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API + App", "onAutoForward": "silent" },
    "5173": { "label": "Vite dev server", "onAutoForward": "openBrowser" }
  },
  "remoteEnv": {
    "GOOGLE_CLIENT_ID": "${localEnv:GOOGLE_CLIENT_ID}",
    "GOOGLE_CLIENT_SECRET": "${localEnv:GOOGLE_CLIENT_SECRET}"
  }
}
